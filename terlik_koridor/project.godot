; Engine configuration file.
config_version=5

[application]

config/name="Anne Terliği - Koridor"
config/name_localized={
"en": "Mom's Slipper: Hallway",
"es": "La Chancla: Pasillo",
"id": "Sandal Ibu: Lorong",
"pt": "Chinelo da Mãe: Corredor"
}
run/main_scene="res://consent.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon_512.png"

[autoload]

Loc="*res://loc.gd"
Sfx="*res://sfx.gd"
Ads="*res://ads.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("res://addons/LevelPlayAds/plugin.cfg")
